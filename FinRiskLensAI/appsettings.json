{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "DbType": "SqlServer",
    "ConnectionStrings": {
      "PostgreSQL": "Host=localhost;Port=5432;Database=CreditRuleEngine;Username=postgres;Password=postgres;Include Error Detail=true",
      "SqlServer": "Server=(localdb)\\MSSQLLocalDB;Database=CreditRuleEngine;Trusted_Connection=True;TrustServerCertificate=true"
    }
  },
  "Jwt": {
    "Key": "ChangeMe-CreditRuleEngine-Dev-Signing-Key-Min-32-Bytes-Long!!",
    "Issuer": "CreditRuleEngine",
    "Audience": "CREClients",
    "ExpirySeconds": 3600
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/cre-.log",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*"
}
