@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Financial Health Report | UCN Fibrenet Private Limited</title>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.3/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>

<style>
:root{
    --maroon-deep:#4a0018;
    --maroon:#7d1230;
    --rose:#974354;
    --blush:#c98a9a;
    --gold:#a9791b;
    --emerald:#0f5137;
    --paper:#f8f4f2;
    --card:#ffffff;
    --ink:#241a1e;
    --ink-soft:#6b585f;
    --hairline:#ecdfe3;
    --font-headline:'Sora',sans-serif;
    --font-body:'Inter',sans-serif;
    --font-data:'JetBrains Mono',monospace;
    --radius-lg:20px;
    --radius-md:14px;
}
*{ box-sizing:border-box; }
html{ scroll-behavior:smooth; }
body{
    background:
        radial-gradient(900px 500px at 100% 0%, rgba(151,67,84,.06), transparent 60%),
        var(--paper);
    color:var(--ink);
    font-family:var(--font-body);
    -webkit-font-smoothing:antialiased;
}
::selection{ background:#f0c9d5; }
::-webkit-scrollbar{ width:10px; height:10px; }
::-webkit-scrollbar-thumb{ background:#dcc3ca; border-radius:99px; }
::-webkit-scrollbar-track{ background:transparent; }

/* ===== Utility bar ===== */
.print-bar{ background:#fff; border-bottom:1px solid var(--hairline); position:sticky; top:0; z-index:50; }

/* ===== Quick nav ===== */
.quicknav-wrap{ background:#fff; border-bottom:1px solid var(--hairline); position:sticky; top:0; z-index:40; }
.quicknav{ display:flex; gap:6px; overflow-x:auto; padding:10px 0; scrollbar-width:none; }
.quicknav::-webkit-scrollbar{ display:none; }
.quicknav a{
    flex:0 0 auto; font-size:.78rem; font-weight:600; color:var(--maroon-deep);
    background:#fbf2f4; border:1px solid var(--hairline); border-radius:999px;
    padding:7px 14px; text-decoration:none; white-space:nowrap; transition:.15s;
}
.quicknav a:hover{ background:var(--maroon-deep); color:#fff; border-color:var(--maroon-deep); }

/* ===== Letterhead / Hero ===== */
.report-letterhead{
    background:
        radial-gradient(1100px 460px at 88% -14%, rgba(255,255,255,.10), transparent 62%),
        radial-gradient(700px 400px at 8% 120%, rgba(255,255,255,.06), transparent 60%),
        linear-gradient(125deg, #38000f 0%, var(--maroon-deep) 42%, var(--maroon) 100%);
    color:#fff;
    position:relative;
    overflow:hidden;
    padding: 0 24px;
}
.report-letterhead::after{
    content:"";
    position:absolute; inset:0;
    background-image:repeating-linear-gradient(115deg, rgba(255,255,255,.035) 0 2px, transparent 2px 46px);
    pointer-events:none;
}
.letterhead-inner{ position:relative; z-index:1; padding:34px 0 30px; }

.brand-row{ display:flex; align-items:center; gap:12px; }
.brand-mark{
    width:44px; height:44px; border-radius:12px;
    background:rgba(255,255,255,.14);
    display:flex; align-items:center; justify-content:center;
    font-family:var(--font-headline); font-weight:800; font-size:1.05rem;
    border:1px solid rgba(255,255,255,.25);
}
.brand-name{ font-family:var(--font-headline); font-weight:700; font-size:1.02rem; }
.brand-tag{ font-size:.7rem; color:#f0c9d5; letter-spacing:.08em; text-transform:uppercase; }

.report-eyebrow{ font-size:.72rem; letter-spacing:.16em; text-transform:uppercase; color:#f0c9d5; margin-bottom:6px; font-weight:600; }
.report-entity{ font-family:var(--font-headline); font-weight:800; font-size:2rem; line-height:1.15; }
.report-meta-line{ font-size:.83rem; color:#f3d6df; margin-top:10px; display:flex; flex-wrap:wrap; gap:0; }
.report-meta-line span{ display:inline-flex; align-items:center; gap:5px; }
.report-meta-line span+span::before{ content:"•"; margin:0 10px; color:#c07f92; }

.score-plate{
    background:rgba(255,255,255,.10);
    border:1px solid rgba(255,255,255,.22);
    border-radius:var(--radius-md);
    padding:16px 24px;
    text-align:center;
    backdrop-filter:blur(3px);
    min-width:170px;
}
.score-plate .num{ font-family:var(--font-headline); font-weight:800; font-size:2.5rem; line-height:1; }
.score-plate .denom{ font-size:.7rem; color:#f0c9d5; letter-spacing:.06em; }
.score-plate .band{ display:inline-flex; align-items:center; gap:6px; margin-top:9px; padding:4px 12px; border-radius:999px; background:#e8f1e3; color:#3d6b1f; font-weight:700; font-size:.78rem; }

/* Glass KPI strip inside hero */
.hero-kpis{ margin-top:26px; }
.hero-kpi{
    background:rgba(255,255,255,.09);
    border:1px solid rgba(255,255,255,.18);
    border-radius:14px;
    padding:14px 16px;
    height:100%;
}
.hero-kpi .ic{ width:32px; height:32px; border-radius:9px; background:rgba(255,255,255,.14); display:flex; align-items:center; justify-content:center; font-size:.95rem; margin-bottom:8px; }
.hero-kpi .v{ font-family:var(--font-headline); font-weight:800; font-size:1.28rem; line-height:1.1; }
.hero-kpi .k{ font-size:.7rem; color:#f0c9d5; text-transform:uppercase; letter-spacing:.05em; margin-top:2px; }
.hero-kpi .d{ font-size:.68rem; color:#e2a9b8; margin-top:3px; }

/* ===== Body wrap ===== */
.fhc-wrap{ padding:34px 0 60px; }
.fhc-card{ background:var(--card); border:1px solid var(--hairline); border-radius:var(--radius-lg); padding:24px 26px; box-shadow:0 4px 18px rgba(74,0,24,.06); height:100%; transition:box-shadow .2s, transform .2s; }
.fhc-card:hover{ box-shadow:0 8px 28px rgba(74,0,24,.10); }
.fhc-title{ font-family:var(--font-headline); font-weight:700; color:var(--maroon-deep); }
.fhc-sub{ color:var(--rose); font-size:.85rem; }
.fhc-section-label{ font-size:.72rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase; color:var(--rose); margin-bottom:16px; display:flex; align-items:center; gap:7px; }
.fhc-section-label .bi{ font-size:.85rem; }

.section-divider{ display:flex; align-items:center; gap:14px; margin:44px 0 20px; scroll-margin-top:110px; }
.section-divider .num{ font-family:var(--font-data); font-weight:700; font-size:.76rem; color:#fff; background:var(--maroon-deep); border-radius:7px; padding:4px 10px; }
.section-divider .txt{ font-family:var(--font-headline); font-weight:700; color:var(--maroon-deep); font-size:1.15rem; }
.section-divider .line{ flex:1; height:1px; background:linear-gradient(90deg, var(--hairline), transparent); }

.band-chip{ display:inline-flex; align-items:center; gap:6px; padding:6px 14px; border-radius:999px; font-weight:700; font-size:.85rem; }
.band-Excellent{ background:#e3f4ea; color:#0f5137; }
.band-Good{ background:#e8f1e3; color:#3d6b1f; }
.band-Fair{ background:#fdf3d7; color:#8a6d00; }
.band-AtRisk{ background:#fde8d7; color:#9c4a00; }
.band-HighRisk{ background:#fbe0e0; color:#8b1020; }

/* Company snapshot */
.snap-item{ display:flex; gap:12px; align-items:flex-start; padding:11px 0; border-bottom:1px dashed var(--hairline); }
.snap-item:last-child{ border-bottom:none; }
.snap-item .ic{ flex:0 0 34px; height:34px; border-radius:9px; background:#fbf2f4; color:var(--maroon-deep); display:flex; align-items:center; justify-content:center; font-size:.95rem; }
.snap-item .k{ font-size:.7rem; text-transform:uppercase; letter-spacing:.05em; color:var(--ink-soft); }
.snap-item .v{ font-weight:600; font-size:.92rem; color:#2b2026; }

.stat-tile{ background:#faf4f5; border:1px solid var(--hairline); border-radius:12px; padding:13px 15px; }
.stat-tile .v{ font-family:var(--font-headline); font-weight:700; font-size:1.18rem; color:#2b2026; }
.stat-tile .k{ font-size:.7rem; color:var(--rose); text-transform:uppercase; letter-spacing:.06em; }

.dim-row{ display:flex; align-items:center; gap:14px; padding:10px 0; flex-wrap:wrap; }
.dim-name{ flex:0 0 190px; font-size:.85rem; color:#2b2026; font-weight:500; }
.dim-track{ flex:1 1 120px; height:11px; border-radius:999px; background:#f2e6ea; overflow:hidden; }
.dim-fill{ height:100%; border-radius:999px; background:linear-gradient(90deg, var(--rose), var(--maroon-deep)); position:relative; }
.dim-val{ flex:0 0 90px; text-align:right; font-size:.82rem; font-weight:600; color:var(--maroon-deep); font-family:var(--font-data); }

.expl-item{ display:flex; gap:10px; padding:10px 0; border-bottom:1px dashed var(--hairline); font-size:.88rem; align-items:flex-start; }
.expl-item:last-child{ border-bottom:none; }
.expl-item .bi{ margin-top:2px; }
.expl-dim{ font-size:.7rem; color:var(--rose); text-transform:uppercase; letter-spacing:.05em; }

.reco-card{ border:1px solid var(--hairline); border-left:5px solid var(--maroon-deep); border-radius:12px; padding:16px 18px; background:linear-gradient(180deg,#fffdfc,#fff8fa); }
.reco-amt{ font-family:var(--font-headline); font-weight:700; color:var(--maroon-deep); font-size:1.15rem; }

.gauge-box{ position:relative; max-width:340px; margin:0 auto; width:100%; }
.gauge-box canvas{ width:100% !important; height:auto !important; }
.gauge-center{ position:absolute; left:0; right:0; bottom:2%; text-align:center; pointer-events:none; }
.gauge-score{ font-family:var(--font-headline); font-size:2.7rem; font-weight:800; color:var(--maroon-deep); line-height:1; }
.gauge-of{ font-size:.78rem; color:var(--rose); }
.band-legend{ display:flex; justify-content:center; flex-wrap:wrap; gap:8px; margin-top:14px; font-size:.68rem; }
.band-legend span{ display:inline-flex; align-items:center; gap:5px; color:var(--ink-soft); }
.band-legend i{ width:9px; height:9px; border-radius:3px; display:inline-block; }

.lending-notes{ background:#faf4f5; border:1px solid var(--hairline); border-radius:12px; padding:15px 17px; }
.lending-notes-head{ font-size:.72rem; font-weight:700; letter-spacing:.07em; text-transform:uppercase; color:var(--rose); margin-bottom:10px; display:flex; align-items:center; gap:6px; }
.lending-note{ display:flex; gap:10px; align-items:flex-start; font-size:.8rem; line-height:1.55; color:#5c4a50; padding:8px 0; border-top:1px dashed #ecdce2; }
.lending-note:first-of-type{ border-top:none; padding-top:0; }
.lending-note .bi{ color:var(--emerald); font-size:.85rem; margin-top:2px; flex-shrink:0; }
.lending-note.warn{ color:#7a4a12; }
.lending-note.warn .bi{ color:var(--gold); }

.anomaly-box{ border:1px solid #f3d19c; background:#fff8ec; border-radius:12px; padding:15px 17px; font-size:.88rem; }
.anomaly-box.flagged{ border-color:#e79b9b; background:#fdf0f0; }
.ratio-row{ font-family:var(--font-body); padding:12px 0; border-bottom:1px dashed var(--hairline); }
.ratio-row:last-child{ border-bottom:none; }
.ratio-row .mono{ font-family:var(--font-data); }

.chart-box{ position:relative; width:100%; }
.chart-box canvas{ max-width:100%; }

.exec-summary{ font-size:.98rem; line-height:1.75; color:#3c2c31; }
.exec-summary strong{ color:var(--maroon-deep); }

.source-chip{ display:flex; align-items:center; gap:10px; padding:12px 14px; border:1px solid var(--hairline); border-radius:12px; background:#fbf7f6; font-size:.82rem; }
.source-chip .bi{ font-size:1.1rem; color:var(--maroon-deep); }
.source-chip.off{ opacity:.5; }

.report-footer{ border-top:1px solid var(--hairline); padding:26px 0 44px; }
.report-footer .fhc-sub{ font-size:.78rem; }

/* ===== Responsive ===== */
@@media (max-width: 767.98px){
    .letterhead-inner{ padding:26px 0 22px; }
    .report-entity{ font-size:1.4rem; }
    .report-meta-line{ flex-direction:column; gap:4px; font-size:.78rem; }
    .report-meta-line span+span::before{ content:""; margin:0; }
    .score-plate{ width:100%; margin-top:16px; }
    .fhc-card{ padding:18px 16px; border-radius:16px; }
    .dim-name{ flex-basis:100%; }
    .dim-val{ flex:0 0 auto; margin-left:auto; }
    .ratio-row{ display:flex; flex-direction:column; gap:8px; }
    .ratio-row .text-end{ text-align:left !important; }
    .section-divider .txt{ font-size:1rem; }
    .section-divider{ margin:32px 0 16px; }
    .brand-tag{ display:none; }
}
/* ===== Breakdown donut + legend (income / expense style) ===== */
.breakdown-row{ display:flex; align-items:center; gap:22px; flex-wrap:wrap; }
.breakdown-donut{ position:relative; flex:0 0 auto; width:160px; height:160px; }
.breakdown-donut canvas{ width:100% !important; height:100% !important; }
.breakdown-center{ position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; pointer-events:none; text-align:center; }
.breakdown-center .pct{ font-family:var(--font-headline); font-weight:800; font-size:1.5rem; color:var(--maroon-deep); line-height:1; }
.breakdown-center .lbl{ font-size:.62rem; color:var(--ink-soft); text-transform:uppercase; letter-spacing:.04em; margin-top:2px; max-width:90px; }
.breakdown-legend{ flex:1 1 220px; min-width:200px; }
.legend-row{ display:flex; align-items:center; gap:9px; padding:6px 0; border-bottom:1px dashed var(--hairline); font-size:.84rem; }
.legend-row:last-child{ border-bottom:none; }
.legend-dot{ width:10px; height:10px; border-radius:3px; flex:0 0 10px; }
.legend-name{ flex:1; color:#2b2026; }
.legend-amt{ font-family:var(--font-data); font-weight:600; color:var(--maroon-deep); font-size:.82rem; }
.breakdown-total{ font-size:.72rem; color:var(--rose); text-transform:uppercase; letter-spacing:.05em; margin-top:10px; }

/* ===== Loan & obligations checklist ===== */
.oblig-row{ display:flex; align-items:center; gap:12px; padding:10px 0; border-bottom:1px dashed var(--hairline); }
.oblig-row:last-child{ border-bottom:none; }
.oblig-row .ic{ flex:0 0 26px; height:26px; border-radius:50%; background:#e3f4ea; color:#0f5137; display:flex; align-items:center; justify-content:center; font-size:.8rem; }
.oblig-row .name{ flex:1; font-size:.88rem; color:#2b2026; font-weight:500; }
.oblig-row .amt{ font-family:var(--font-data); font-weight:700; color:var(--maroon-deep); font-size:.9rem; }
.oblig-flag{ display:flex; align-items:center; justify-content:center; gap:8px; margin-top:12px; padding:10px 14px; border-radius:10px; background:#e3f4ea; color:#0f5137; font-weight:700; font-size:.85rem; }

/* ===== Risk indicator bars ===== */
.risk-row{ padding:11px 0; border-bottom:1px dashed var(--hairline); }
.risk-row:last-child{ border-bottom:none; }
.risk-row-head{ display:flex; justify-content:space-between; align-items:baseline; margin-bottom:6px; gap:8px; flex-wrap:wrap; }
.risk-row-head .name{ font-size:.85rem; font-weight:600; color:#2b2026; }
.risk-row-head .val{ font-family:var(--font-data); font-weight:700; color:var(--maroon-deep); font-size:.88rem; }
.risk-track{ height:9px; border-radius:999px; background:#f2e6ea; overflow:hidden; flex:1; }
.risk-fill{ height:100%; border-radius:999px; }
.risk-track-row{ display:flex; align-items:center; gap:10px; }
.risk-chip{ flex:0 0 auto; font-size:.66rem; font-weight:700; padding:3px 10px; border-radius:999px; text-transform:uppercase; letter-spacing:.03em; }
.risk-chip.strong{ background:#e3f4ea; color:#0f5137; }
.risk-chip.adequate{ background:#fdf3d7; color:#8a6d00; }
.risk-chip.weak{ background:#fbe0e0; color:#8b1020; }

@@media (max-width: 767.98px){
    .breakdown-row{ justify-content:center; text-align:left; }
}

/* ===== Print ===== */

/* ===== Print Optimization ===== */
@@media print{
    @@page { 
        size: A4; 
        margin: 15mm 10mm 10mm 10mm; /* Increased top margin (22mm) for breathing room below browser headers */
    }

    /* Override and reset the margin for the 1st Page only */
    @@page :first {
        margin: 10mm 10mm 10mm 10mm; /* Standard close-to-top layout for the cover / initial letterhead */
    }
    .print-bar, .quicknav-wrap{ display:none !important; }
    html, body{ background:#fff !important; }
    body{ font-size:11px; -webkit-print-color-adjust:exact; print-color-adjust:exact; }
    .container{ max-width:100% !important; width:100% !important; }
    .report-letterhead{ -webkit-print-color-adjust:exact; print-color-adjust:exact; color-adjust:exact; }
    .report-letterhead::after{ display:none; }
    .fhc-wrap{ padding:10px 0 0; }

    /* Prevent cards, charts, and the data source row from splitting across pages[cite: 1] */
    .fhc-card, .chart-box, .gauge-box, .breakdown-row,
    .reco-card, .anomaly-box, .stat-tile, .hero-kpi,
    .oblig-row, .risk-row, .ratio-row, .dim-row,
    .row:has(.source-chip) {                     /* FIXED: Forces all source chips to stay on the same page */
        break-inside: avoid !important; 
        page-break-inside: avoid !important;
    }
    .fhc-card{ box-shadow:none !important; border:1px solid #e6d7db !important; margin-bottom: 12px !important; }
    .fhc-card:hover{ box-shadow:none !important; }

    /* Force 2-column grid for snap-items inside cards[cite: 1] */
    .fhc-card {
        display: block !important;
    }
    .fhc-card > .snap-item {
        display: inline-flex !important; 
        width: 48% !important; 
        box-sizing: border-box !important;
        vertical-align: top !important;
        margin-right: 1% !important;
        padding: 8px 4px !important;
        border-bottom: 1px dashed var(--hairline) !important;
    }
    .snap-item .ic { 
        display: inline-flex !important; 
        vertical-align: middle; 
        margin-right: 8px; 
        flex-shrink: 0;
    }

    /* Adjust section dividers */
    .section-divider{
        break-after: avoid !important; 
        page-break-after: avoid !important;
        break-before: auto !important; 
        page-break-before: auto !important;
        margin-top: 15px !important;
        margin-bottom: 10px !important;
    }
    #snapshot.section-divider{ break-before: auto !important; page-break-before: auto !important; }
    .report-footer{ break-before: auto; page-break-before: auto; }

    p, .exec-summary{ orphans:3; widows:3; }
    .fhc-section-label{ break-after: avoid !important; page-break-after: avoid !important; }

    /* Layout cleanups for lists */
    .ratio-row{ display:block !important; padding:6px 0; }
    .ratio-row > div:first-child{ margin-bottom:2px; }
    .ratio-row [style*="flex:0 0 90px"]{ display:inline-block !important; text-align:left !important; vertical-align:middle; margin-right:12px; }
    .ratio-row > span.badge{ display:inline-block !important; vertical-align:middle; }

    .oblig-row{ display:block !important; padding:5px 0; }
    .oblig-row .ic{ display:inline-flex !important; vertical-align:middle; margin-right:8px; }
    .oblig-row .name{ display:inline; }
    .oblig-row .amt{ display:block; margin-top:2px; }

    .dim-row{ display:block !important; padding:5px 0; }
    .dim-name{ display:block; margin-bottom:2px; }
    .dim-track{ display:inline-block !important; width:65%; vertical-align:middle; }
    .dim-val{ display:inline-block !important; margin-left:8px; }

    .risk-row-head{ display:block !important; }
    .risk-row-head .val{ display:inline-block; margin-left:8px; }
    .risk-track-row{ display:block !important; margin-top:4px; }
    .risk-track{ display:inline-block !important; width:70%; vertical-align:middle; }
    .risk-chip{ display:inline-block !important; margin-left:8px; vertical-align:middle; }

    .hero-kpi, .stat-tile, .snap-item .ic, .source-chip, .band-chip, .badge,
    .reco-card, .score-plate, .dim-fill, .risk-fill, .legend-dot, .oblig-row .ic,
    .risk-chip, .oblig-flag{
        -webkit-print-color-adjust:exact; print-color-adjust:exact; color-adjust:exact;
    }

    /* Stack outer container grid wrappers uniformly */
    .col-lg-4, .col-lg-5, .col-lg-6, .col-lg-7{
        flex:0 0 100% !important; max-width:100% !important; width:100% !important;
    }
    .row.g-4 > [class*="col-"]{ margin-bottom:12px; }

    .chart-box canvas, .breakdown-donut canvas{ max-width:100% !important; height:auto !important; }
    .quicknav{ display:none; }
    a[href]::after{ content:""; }
    .score-plate .num {
        margin-top: 15px !important;  /* Adjust this value up/down to position the 718 perfectly */
        line-height: 1.1 !important;
        display: block !important;
    }

    .score-plate .denom {
        margin-top: 2px !important;   /* Keeps the denominator neatly tucked right below the number */
        margin-bottom: 8px !important;
        display: block !important;
    }

    /* 2. Pulls the entire Score Composition section tightly to the top */
    .score-plate {
        margin-top: -25px !important; /* Pulls the wrapper card up into the empty whitespace */
        position: relative !important;
        break-before: auto !important;
        page-break-before: auto !important;
    }
.gauge-box,
    .fhc-card:has(canvas[id*="gauge"]),
    div:has(> canvas[style*="width"]) {
        min-height: 280px !important; /* Forces enough room for the semi-circle canvas */
        margin-bottom: 20px !important;
        position: relative !important;
        display: block !important;
    }

    /* 2. Target the Score Composition container to sit neatly below the forced height */
    .fhc-card:has(.hero-kpi),
    .fhc-card:has(.stat-tile),
    div:has(> .fhc-section-label) {
        margin-top: 10px !important; /* Gives breathing room right below the gauge card */
        clear: both !important;
    }
.fhc-card, 
    div:has(> .fhc-section-label) {
        height: auto !important;
