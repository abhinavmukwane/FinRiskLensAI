                    <div class="snap-item"><div class="ic"><i class="bi bi-broadcast-pin"></i></div><div><div class="k">Industry / NIC Code</div><div class="v">Telecommunications — NIC 61</div></div></div>
                    <div class="snap-item"><div class="ic"><i class="bi bi-geo-alt"></i></div><div><div class="k">State Jurisdiction</div><div class="v">Maharashtra (GST state code 27)</div></div></div>
