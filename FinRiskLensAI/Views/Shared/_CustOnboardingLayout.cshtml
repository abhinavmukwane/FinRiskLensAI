<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FinRiskLens AI | MSME Credit Risk Intelligence</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.3/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&display=swap"
          rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.js"></script>
    <link href="~/css/CustomerOnboarding.css" rel="stylesheet" />
    <link href="~/css/index.css" rel="stylesheet" />
    <style>
        :root {
            --primary: #5e0023;
            --primary-container: #801538;
            --on-primary: #ffffff;
            --secondary: #725c1e;
            --secondary-container: #fcdd91;
            --background: #fbf9f6;
            --surface-lowest: #ffffff;
            --surface-low: #f5f3f0;
            --on-surface: #1b1c1a;
            --on-surface-variant: #564145;
            --outline-variant: #dcbfc3;
            --danger: #b3392c;
            --success: #2f7d5c;
        }

        .form-check-input.rv-checkbox {
            width: 1.25em;
            height: 1.25em;
            border: 2px solid var(--maroon) !important;
            border-radius: .3rem;
            cursor: pointer;
            transition: all .15s ease;
            background-color: #fff;
            background-image: none !important;
            appearance: none;
            -webkit-appearance: none;
            position: relative;
            box-sizing: border-box;
            margin: 0;
            flex-shrink: 0;
        }

            .form-check-input.rv-checkbox:checked {
                background-color: var(--maroon) !important;
                border-color: var(--maroon) !important;
            }

                .form-check-input.rv-checkbox:checked::after {
                    content: "";
                    position: absolute;
                    left: 50%;
                    top: 45%;
                    width: 30%;
                    height: 55%;
                    border: solid #fff;
                    border-width: 0 2px 2px 0;
                    transform: translate(-50%, -50%) rotate(45deg);
                }

            .form-check-input.rv-checkbox:focus {
                box-shadow: 0 0 0 .2rem rgba(94,0,35,.15) !important;
            }

            .form-check-input.rv-checkbox:hover {
                border-color: var(--maroon) !important;
            }

        /* ---------- OTP display modal ---------- */
        #otpDisplayModal .modal-content {
            border: none;
            border-radius: .9rem;
            overflow: hidden;
            box-shadow: 0 24px 60px -20px rgba(94,0,35,.45);
        }

        #otpDisplayModal .modal-header {
            background: linear-gradient(120deg, var(--primary) 0%, var(--primary-container) 100%) !important;
            border-bottom: none;
            padding: 1.25rem 1.5rem;
        }

        #otpDisplayModal .modal-title {
            color: var(--on-primary);
            font-weight: 800;
            font-size: 1rem;
            display: flex;
            align-items: center;
            gap: .6rem;
        }

            #otpDisplayModal .modal-title i {
                font-size: 1.1rem;
                color: var(--secondary-container);
            }

        #otpDisplayModal .btn-close {
            filter: brightness(0) invert(1);
            opacity: .85;
        }

            #otpDisplayModal .btn-close:hover {
                opacity: 1;
            }

        #otpDisplayModal .modal-body {
            padding: 2rem 1.5rem 1.5rem;
            background-color: var(--surface-lowest);
        }

            #otpDisplayModal .modal-body p {
                font-size: .85rem;
                color: var(--on-surface-variant);
            }

        .otp-display-box {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            background-color: var(--surface-low);
            border: 1.5px dashed var(--outline-variant);
            border-radius: .6rem;
            padding: .85rem 1.5rem;
            margin: .25rem 0 .5rem;
        }

        #otpDisplayValue {
            font-family: 'Manrope', sans-serif;
            font-weight: 800;
            font-size: 1.8rem;
            letter-spacing: .35rem;
            color: var(--primary);
            margin: 0;
        }

        .otp-copy-btn {
            background: none;
            border: none;
            color: var(--secondary);
            font-size: 1.1rem;
            padding: .25rem;
            line-height: 1;
            transition: color .15s ease, transform .1s ease;
        }

            .otp-copy-btn:hover {
                color: var(--primary);
            }

            .otp-copy-btn:active {
                transform: scale(.9);
            }

        .otp-dev-note {
            display: flex;
            align-items: flex-start;
            gap: .5rem;
            background-color: rgba(114,92,30,.08);
            border: 1px solid rgba(252,221,145,.4);
            border-radius: .5rem;
            padding: .6rem .8rem;
            font-size: .75rem;
            color: var(--on-surface-variant);
            text-align: left;
            margin-top: 1rem;
        }

            .otp-dev-note i {
                color: var(--secondary);
                margin-top: .1rem;
            }

        #otpDisplayModal .modal-footer {
            background-color: var(--surface-low);
            border-top: 1px solid rgba(220,191,195,.4);
            padding: 1rem 1.5rem;
        }

            #otpDisplayModal .modal-footer .btn-maroon {
                width: 100%;
                justify-content: center;
                display: flex;
                align-items: center;
                gap: .4rem;
            }

        /* Bhashini language widget — themed to sit in the maroon brandbar */
        .brandbar { overflow: visible; }                 /* let the language dropdown escape the header */
        .bhashini-plugin-container { display: flex; align-items: center; }
        .bhashini-plugin-container .bhashini-dropdown-btn {
            background: rgba(255,255,255,.08);
            border: 1px solid rgba(255,255,255,.2);
            border-radius: .75rem;
            padding: .3rem .45rem;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer;
            transition: background .2s ease, border-color .2s ease;
        }
        .bhashini-plugin-container .bhashini-dropdown-btn:hover {
            background: rgba(255,255,255,.15);
            border-color: var(--gold-soft);
        }
        .bhashini-plugin-container .bhashini-dropdown-btn-icon svg { display: block; width: 24px; height: 24px; }

    </style>

</head>

<body>

    <!-- Header -->
    <!-- Brand bar -->
    <div class="brandbar py-3">
        <div class="container d-flex align-items-center justify-content-between">
            <a href="@Url.Action("Index", "Home")" class="d-flex align-items-center gap-3 text-decoration-none">
                <img src="~/Logo.png" alt="FinRiskLens AI" class="brand-logo"
                     style="height:46px;width:auto;border-radius:10px;background:#fff;" />
                <div>
                    <div class="brand-name">FinRiskLens <span style="color:var(--gold-soft)">AI</span></div>
                    <div class="brand-sub">IDBI Innovate · MSME Onboarding</div>
                </div>
            </a>
            <div class="d-flex align-items-center gap-3">
                @if (ViewBag.Title != "CustLogin")
                {
                    <a href="/Auth/CustLogin"
                       class="btn text-white px-3 py-2 rounded-3 font-heading d-flex align-items-center gap-2"
                       style="background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.2); font-size: 0.85rem; font-weight: 600; transition: all 0.2s ease;"
                       onmouseover="this.style.background='rgba(255, 255, 255, 0.15)'; this.style.borderColor='var(--gold-soft)'"
                       onmouseout="this.style.background='rgba(255, 255, 255, 0.08)'; this.style.borderColor='rgba(255, 255, 255, 0.2)'">
                        <i class="bi bi-box-arrow-in-right"
                           style="font-size: 1.1rem; vertical-align: middle;"></i>
                        Login
                    </a>
                }
                <!-- Translation Plugin -->
                <div class="bhashini-plugin-container"></div>
            </div>

        </div>
    </div>

    <!-- Main Body -->
    <main>
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-light border-top px-margin-desktop py-5 mt-5">
        <div class="mx-auto" style="max-width: 1440px;">
            <div class="row g-4">
                <div class="col-lg-4 space-y-3">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="bg-primary rounded-3 d-flex align-items-center justify-content-center"
                             style="width: 1.75rem; height: 1.75rem;">
                            <i class="bi bi-bar-chart-fill text-white" style="font-size: 14px;"></i>
                        </div>
                        <span class="h5 text-primary font-heading mb-0 fw-bold">FinRiskLens AI</span>
                    </div>
                    <p class="small text-secondary" style="max-width: 320px;">
                        The future of credit risk is data-driven,
                        transparent, and inclusive. Join the revolution in MSME banking.
                    </p>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <h5 class="font-data small text-dark uppercase tracking-widest mb-3"
                        style="font-size: 10px; font-weight: 700;">
                        Platform
                    </h5>
                    <ul class="list-unstyled space-y-2 small">
                        <li>
                            <a class="text-secondary hover-text-primary text-decoration-none" href="#">Risk Modeling</a>
                        </li>
                        <li>
                            <a class="text-secondary hover-text-primary text-decoration-none" href="#">
                                Data
                                Connectors
                            </a>
                        </li>
                        <li>
                            <a class="text-secondary hover-text-primary text-decoration-none" href="#">
                                Decision
                                Engine
                            </a>
                        </li>
                        <li>
                            <a class="text-secondary hover-text-primary text-decoration-none" href="#">
                                Compliance
                                Audit
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <h5 class="font-data small text-dark uppercase tracking-widest mb-3"
                        style="font-size: 10px; font-weight: 700;">
                        Company
                    </h5>
                    <ul class="list-unstyled space-y-2 small">
                        <li><a class="text-secondary hover-text-primary text-decoration-none" href="#">About Us</a></li>
                        <li>
                            <a class="text-secondary hover-text-primary text-decoration-none" href="#">Methodology</a>
                        </li>
                        <li><a class="text-secondary hover-text-primary text-decoration-none" href="#">Careers</a></li>
                        <li><a class="text-secondary hover-text-primary text-decoration-none" href="#">Contact</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <h5 class="font-data small text-dark uppercase tracking-widest mb-3"
                        style="font-size: 10px; font-weight: 700;">
                        Legal
                    </h5>
                    <ul class="list-unstyled space-y-2 small">
                        <li>
                            <a class="text-secondary hover-text-primary text-decoration-none" href="#">
                                Privacy
                                Policy
                            </a>
                        </li>
                        <li>
                            <a class="text-secondary hover-text-primary text-decoration-none" href="#">
                                Terms of
                                Service
                            </a>
                        </li>
                        <li><a class="text-secondary hover-text-primary text-decoration-none" href="#">Security</a></li>
                    </ul>
                </div>
            </div>

            <div class="mt-5 pt-3 border-top border-secondary border-opacity-10 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <p class="font-data small text-secondary mb-0">© @DateTime.Now.Year FinRiskLens AI. All rights reserved.</p>
                <div class="d-flex gap-3">
                    <a class="text-secondary hover-text-primary" href="#">
                        <i class="bi bi-globe2 fs-5"></i>
                    </a>
                    <a class="text-secondary hover-text-primary" href="#">
                        <i class="bi bi-at fs-5"></i>
                    </a>
                    <a class="text-secondary hover-text-primary" href="#">
                        <i class="bi bi-share-fill fs-5"></i>
                    </a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/js/website_translation_utility.js"
            asp-append-version="true"
            page-source-language="en"
            translation-language-list="en,hi,mr,ta,gu,gom,sa"
            language_order="en,hi,mr,ta,gu,gom,sa"
            initial_preferred_language="en"
            language-icon-color="#F3E2B2">
    </script>
</body>
</html>