
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FinRiskLens AI | MSME Credit Risk Intelligence</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />

    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&family=Sora:wght@100..900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.js"></script>
    <link href="~/css/dashboard.css" rel="stylesheet" />


<style>
    :root {
    --maroon: #8b1538;
    }

    .verification-modal {
    border: none;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0,0,0,.15);
    }

    .modal-header {
    background: linear-gradient(120deg, #57001d 0%, #8b1538 100%);
    border-bottom: none;
    padding: 1.25rem 1.5rem;
    }

    .modal-header .modal-title {
    color: #fff;
    font-weight: 700;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    gap: .5rem;
    padding: 0px 0px 9px;
    }

    .modal-header .btn-close {
    filter: brightness(0) invert(1);
    opacity: .85;
    }

    .modal-header .btn-close:hover {
    opacity: 1;
    }

    .custom-input {
    border-radius: 10px;
    height: 48px;
    border: 1px solid #d8d8d8;
    }

    .custom-input:focus {
    border-color: #8b1538;
    box-shadow: 0 0 0 .15rem rgba(139,21,56,.15);
    }

    .consent-box {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    background: #faf7f8;
    border: 1px solid #ead9df;
    border-radius: 10px;
    padding: 15px;
    }

    .consent-box .form-check {
    display: flex;
    align-items: flex-start;
    gap: .6rem;
    padding-left: 0;
    width: 100%;
    }

    .consent-box .form-check-label {
    flex: 1;
    min-width: 0;
    font-size: 12px;
    line-height: 1.6;
    margin-bottom: 0;
    cursor: pointer;
    }

    .form-check-input.rv-checkbox {
    width: 1.25em;
    height: 1.25em;
    border: 2px solid var(--maroon) !important;
    border-radius: .3rem;
    cursor: pointer;
    transition: all .15s ease;
    background-color: #fff;
    background-image: none !important;
    appearance: none;
    -webkit-appearance: none;
    position: relative;
    box-sizing: border-box;
    margin: 0;
    flex-shrink: 0;
    }

    .form-check-input.rv-checkbox:checked {
    background-color: var(--maroon) !important;
    border-color: var(--maroon) !important;
    }

    .form-check-input.rv-checkbox:checked::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 45%;
    width: 30%;
    height: 55%;
    border: solid #fff;
    border-width: 0 2px 2px 0;
    transform: translate(-50%, -50%) rotate(45deg);
    }

    .form-check-input.rv-checkbox:focus {
    box-shadow: 0 0 0 .2rem rgba(94,0,35,.15) !important;
    }

    .form-check-input.rv-checkbox:hover {
    border-color: var(--maroon) !important;
    }

    .btn-theme {
    background: #8b1538;
    color: #fff;
    border-radius: 10px;
    padding: 11px;
    font-weight: 600;
    }

    .btn-theme:hover {
    background: #74112f;
    color: #fff;
    }

    .welcome-banner {
    background: linear-gradient(135deg, #57001d, #8b1538);
    color: #fff;
    border-radius: 16px;
    padding: 20px 26px;
    box-shadow: 0 10px 24px rgba(87,0,29,.18);
    }

    .welcome-banner .greeting {
    font-size: .8rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: #f0c9d5;
    margin-bottom: 4px;
    }

    .welcome-banner .enterprise {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
    }

    .welcome-banner .meta {
    font-size: .82rem;
    color: #f3d6df;
    margin-top: 6px;
    }

    .welcome-banner .meta span + span::before {
    content: "•";
    margin: 0 8px;
    color: #d79aab;
    }
</style>
</head>
<body>

    <div class="app-shell" id="appShell">

        <!-- ============ Sidebar ============ -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <div class="sidebar-brand-mark" style="background:#fff;overflow:hidden;padding:2px;">
                    <img src="~/Logo.png" alt="FinRiskLens AI" style="width:100%;height:100%;object-fit:contain;" />
                </div>
                <div class="sidebar-brand-text">
                    <h1>FinRiskLens AI</h1>
                    <p>MSME Credit Risk</p>
                </div>
            </div>

            <nav class="sidebar-nav">
                <a class="nav-link " href="/Dashboard/CustDashboard">
                    <i class="bi bi-speedometer2"></i>
                    <span>Dashboard</span>
                </a>
                <a class="nav-link" href="/Dashboard/FinancialHealthCard">
                    <i class="bi bi-bar-chart-line"></i>
                    <span>Financial Score</span>
                </a>
                <a class="nav-link" href="/Udyam/UdyamDetails">
                    <i class="bi bi-grid-3x3-gap"></i>
                    <span>Udyam Details</span>
                </a>
                <a class="nav-link" href="#">
                    <i class="bi bi-diagram-3"></i><span>Account Agrigator Details</span>
                </a>
                <a class="nav-link" href="#">
                    <i class="bi bi-receipt"></i> <span>GST Details</span>
                </a>
                <a class="nav-link" href="#">
                    <i class="bi bi-file-earmark-text"></i><span>ITR Details</span>
                </a>
                <a class="nav-link" href="#">
                    <i class="bi bi-credit-card-2-front"></i><span>Transactions</span>
                </a>
            </nav>

            <div class="sidebar-footer">
               
                <div class="sidebar-nav">
                    @* <a class="nav-link" href="#">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                        <span>Help Center</span>
                    </a> *@
                    <a class="nav-link" href="/Auth/Logout">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                        <span>Logout</span>
                    </a>
                </div>
            </div>
        </aside>

        <!-- backdrop for mobile drawer -->
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <!-- ============ Main + Topbar ============ -->
        <main class="main-content">
            <header class="topbar">
                <div class="topbar-left">
                    <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle navigation">
                        <i class="bi bi-list icon-hamburger"></i>
                        <i class="bi bi-x-lg icon-cross"></i>
                    </button>
                    @* <h2 class="topbar-title">Overview Dashboard</h2> *@
                </div>

                <div class="topbar-right">
                   
                    <div class="topbar-actions">
                        
                        @* <span class="topbar-user-name">@enterpriseName</span> *@

@*                         <button class="topbar-avatar" type="button" aria-label="User menu">
                            <i class="bi bi-person"></i>
                        </button> *@
                    </div>
                </div>
            </header>

            <!-- ==== put your page content here ==== -->
            <div>
            @RenderBody()
            </div>
        </main>
    </div>

    <script>
        // Sidebar collapse / expand — hamburger <-> cross toggle
        (function(){
          const appShell = document.getElementById('appShell');
          const toggle = document.getElementById('sidebarToggle');
          const backdrop = document.getElementById('sidebarBackdrop');

          toggle.addEventListener('click', () => appShell.classList.toggle('sidebar-collapsed'));
          backdrop.addEventListener('click', () => appShell.classList.remove('sidebar-collapsed'));
        })();

        document.addEventListener('DOMContentLoaded', function () {
        const currentPath = window.location.pathname.toLowerCase();
        const links = document.querySelectorAll('.sidebar-nav .nav-link');

        links.forEach(link => {
        const linkPath = link.getAttribute('href').toLowerCase();

        // skip placeholder "#" links
        if (linkPath === '#') return;

        if (linkPath === currentPath) {
        link.classList.add('active');
        } else {
        link.classList.remove('active');
        }
        });
        });
    </script>

    @* Universal AI chatbot — pages pass screen data via window.frlChatContext *@
    @await Html.PartialAsync("_Chatbot")
</body>
</html>