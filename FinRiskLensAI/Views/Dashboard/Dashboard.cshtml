@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 mb-4 mb-md-0">
            <div class="border verify-panel p-4 h-100">
                <h5 class="mb-4 fw-bold">Verification Panel</h5>

                <div class="card verify-card shadow-sm mb-3">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">GST</span>
                        <button type="button" class="btn btn-bgcolor btn-sm px-3">Submit</button>
                    </div>
                </div>

                <div class="card verify-card shadow-sm mb-3">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">Account Aggregator</span>
                        <button type="button" class="btn btn-bgcolor btn-sm px-3">Submit</button>
                    </div>
                </div>

                <div class="card verify-card shadow-sm mb-0">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">ITR</span>
                        <button type="button" class="btn btn-bgcolor btn-sm px-3">Submit</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="d-flex flex-column gap-3">

                <!-- GST -->
                <div class="card shadow-sm border-0" style="max-width:280px; background:#F9EEF3; border-radius:15px;">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-receipt-cutoff text-danger fs-4"></i>
                            <span class="fw-bold text-dark text-uppercase small">
                                Goods & Services Tax
                            </span>
                        </div>

                        <p class="card-text text-muted mb-0 d-flex gap-2" style="font-size:0.82rem; line-height:1.6;">
                            <i class="bi bi-info-circle-fill text-primary mt-1"></i>
                            <span>
                                View GST filings, turnover, tax payments, and compliance history.
                            </span>
                        </p>
                    </div>
                </div>

                <!-- Account Aggregator -->
                <div class="card shadow-sm border-0" style="max-width:280px; background:#F9EEF3; border-radius:15px;">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-bank2 text-success fs-4"></i>
                            <span class="fw-bold text-dark text-uppercase small">
                                Account Aggregator
                            </span>
                        </div>

                        <p class="card-text text-muted mb-0 d-flex gap-2" style="font-size:0.82rem; line-height:1.6;">
                            <i class="bi bi-info-circle-fill text-primary mt-1"></i>
                            <span>
                                Securely access bank account data to analyze cash flow and transactions.
                            </span>
                        </p>
                    </div>
                </div>

                <!-- Income Tax Return -->
                <div class="card shadow-sm border-0" style="max-width:280px; background:#F9EEF3; border-radius:15px;">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-file-earmark-text-fill text-warning fs-4"></i>
                            <span class="fw-bold text-dark text-uppercase small">
                                Income Tax Return
                            </span>
                        </div>

                        <p class="card-text text-muted mb-0 d-flex gap-2" style="font-size:0.82rem; line-height:1.6;">
                            <i class="bi bi-info-circle-fill text-primary mt-1"></i>
                            <span>
                                Verify declared income, tax filings, and financial stability.
                            </span>
                        </p>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>