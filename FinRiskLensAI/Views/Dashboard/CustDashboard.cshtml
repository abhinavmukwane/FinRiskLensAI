@{
    ViewBag.Title = "CustDashboard";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    var currentUser = Context.Session.GetCurrentUser();
    var enterpriseName = string.IsNullOrWhiteSpace(currentUser?.NameOfEnterprise)
        ? "there"
        : currentUser!.NameOfEnterprise;
}

<style>
    :root {
        --maroon: #8b1538;
    }
    .verification-modal {
        border: none;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(0,0,0,.15);
    }

    .modal-header {
        background: linear-gradient(120deg, #57001d 0%, #8b1538 100%);
        border-bottom: none;
        padding: 1.25rem 1.5rem;
    }

        .modal-header .modal-title {
            color: #fff;
            font-weight: 700;
            font-size: 1.1rem;
            display: flex;
            align-items: center;
            gap: .5rem;
            padding: 0px 0px 9px;
        }

        .modal-header .btn-close {
            filter: brightness(0) invert(1);
            opacity: .85;
        }

            .modal-header .btn-close:hover {
                opacity: 1;
            }

    .custom-input {
        border-radius: 10px;
        height: 48px;
        border: 1px solid #d8d8d8;
    }

        .custom-input:focus {
            border-color: #8b1538;
            box-shadow: 0 0 0 .15rem rgba(139,21,56,.15);
        }

    .consent-box {
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
        background: #faf7f8;
        border: 1px solid #ead9df;
        border-radius: 10px;
        padding: 15px;
    }

        .consent-box .form-check {
            display: flex;
            align-items: flex-start;
            gap: .6rem;
            padding-left: 0;
            width: 100%;
        }

        .consent-box .form-check-label {
            flex: 1;
            min-width: 0;
            font-size: 12px;
            line-height: 1.6;
            margin-bottom: 0;
            cursor: pointer;
        }

    .form-check-input.rv-checkbox {
        width: 1.25em;
        height: 1.25em;
        border: 2px solid var(--maroon) !important;
        border-radius: .3rem;
        cursor: pointer;
        transition: all .15s ease;
        background-color: #fff;
        background-image: none !important;
        appearance: none;
        -webkit-appearance: none;
        position: relative;
        box-sizing: border-box;
        margin: 0;
        flex-shrink: 0;
    }

        .form-check-input.rv-checkbox:checked {
            background-color: var(--maroon) !important;
            border-color: var(--maroon) !important;
        }

            .form-check-input.rv-checkbox:checked::after {
                content: "";
                position: absolute;
                left: 50%;
                top: 45%;
                width: 30%;
                height: 55%;
                border: solid #fff;
                border-width: 0 2px 2px 0;
                transform: translate(-50%, -50%) rotate(45deg);
            }

        .form-check-input.rv-checkbox:focus {
            box-shadow: 0 0 0 .2rem rgba(94,0,35,.15) !important;
        }

        .form-check-input.rv-checkbox:hover {
            border-color: var(--maroon) !important;
        }

    .btn-theme {
        background: #8b1538;
        color: #fff;
        border-radius: 10px;
        padding: 11px;
        font-weight: 600;
    }

        .btn-theme:hover {
            background: #74112f;
            color: #fff;
        }

    .welcome-banner {
        background: linear-gradient(135deg, #57001d, #8b1538);
        color: #fff;
        border-radius: 16px;
        padding: 20px 26px;
        box-shadow: 0 10px 24px rgba(87,0,29,.18);
    }

        .welcome-banner .greeting {
            font-size: .8rem;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: #f0c9d5;
            margin-bottom: 4px;
        }

        .welcome-banner .enterprise {
            font-size: 1.5rem;
            font-weight: 700;
            line-height: 1.2;
        }

        .welcome-banner .meta {
            font-size: .82rem;
            color: #f3d6df;
            margin-top: 6px;
        }

        .welcome-banner .meta span + span::before {
            content: "•";
            margin: 0 8px;
            color: #d79aab;
        }
</style>

<div class="container-fluid py-5">

    <!-- Welcome greeting -->
    <div class="welcome-banner mb-4">
        <div class="greeting">Welcome back</div>
        <div class="enterprise">
            <i class="bi bi-buildings me-2"></i>@enterpriseName
        </div>
        @* @if (currentUser != null)
        {
            <div class="meta">
                @if (!string.IsNullOrWhiteSpace(currentUser.UdyamNumber))
                {
                    <span>Udyam: @currentUser.UdyamNumber</span>
                }
                @if (!string.IsNullOrWhiteSpace(currentUser.GstinNumber))
                {
                    <span>GSTIN: @currentUser.GstinNumber</span>
                }
                @if (!string.IsNullOrWhiteSpace(currentUser.PanNumber))
                {
                    <span>PAN: @currentUser.PanNumber</span>
                }
            </div>
        } *@
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-md-8 mb-4 mb-md-0">
            <div class="verify-panel p-4">

                <h4 class="fw-bold mb-4">Lets get start</h4>

                <div class="verify-card mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1">GST</h6>
                            <small class="text-muted">Goods & Services Tax Verification</small>
                        </div>

                        <button class="btn btn-submit" data-bs-toggle="modal" data-bs-target="#verificationModal" data-title="Fetch Udyam Details">
                            Fetch Details
                        </button>
                    </div>
                </div>

                <div class="verify-card mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1">Account Aggregator</h6>
                            <small class="text-muted">Bank Statement Verification</small>
                        </div>

                        <button type="button"
                                class="btn btn-submit"
                                data-bs-toggle="modal"
                                data-bs-target="#aaConsentModal">
                            Fetch Details
                        </button>
                    
                    </div>
                </div>

                <div class="verify-card">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1">ITR</h6>
                            <small class="text-muted">Income Tax Return Verification</small>
                        </div>
                        <button class="btn btn-submit" data-bs-toggle="modal" data-bs-target="#itrModal" data-title="Fetch ITR Details">
                            Fetch Details
                        </button>
                    </div>
                </div>

            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="d-flex flex-column gap-3">

                <!-- GST -->
                <div class="card shadow-sm border-0" style="max-width:280px; background:#F9EEF3; border-radius:15px;">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-receipt-cutoff text-danger fs-4"></i>
                            <span class="fw-bold text-dark text-uppercase small">
                                Goods & Services Tax
                            </span>
                        </div>

                        <p class="card-text text-muted mb-0 d-flex gap-2" style="font-size:0.82rem; line-height:1.6;">
                            @* <i class="bi bi-info-circle-fill text-primary mt-1"></i> *@
                            <span>
                                View GST filings, turnover, tax payments, and compliance history.
                            </span>
                        </p>
                    </div>
                </div>

                <!-- Account Aggregator -->
                <div class="card shadow-sm border-0" style="max-width:280px; background:#F9EEF3; border-radius:15px;">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-bank2 text-success fs-4"></i>
                            <span class="fw-bold text-dark text-uppercase small">
                                Account Aggregator
                            </span>
                        </div>

                        <p class="card-text text-muted mb-0 d-flex gap-2" style="font-size:0.82rem; line-height:1.6;">
                            @* <i class="bi bi-info-circle-fill text-primary mt-1"></i> *@
                            <span>
                                Securely access bank account data to analyze cash flow and transactions.
                            </span>
                        </p>
                    </div>
                </div>

                <!-- Income Tax Return -->
                <div class="card shadow-sm border-0" style="max-width:280px; background:#F9EEF3; border-radius:15px;">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-file-earmark-text-fill text-warning fs-4"></i>
                            <span class="fw-bold text-dark text-uppercase small">
                                Income Tax Return
                            </span>
                        </div>

                        <p class="card-text text-muted mb-0 d-flex gap-2" style="font-size:0.82rem; line-height:1.6;">
                            @* <i class="bi bi-info-circle-fill text-primary mt-1"></i> *@
                            <span>
                                Verify declared income, tax filings, and financial stability.
                            </span>
                        </p>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@* Modal *@

<div class="modal fade" id="verificationModal" tabindex="-1"
     aria-labelledby="verificationModalLabel" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content verification-modal">

            <div class="modal-header border-0 pb-0">
                <div>
                    <h5 class="modal-title " id="verificationModalLabel">
                        Fetch Udyam Details
                    </h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <!-- User ID -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        User ID
                    </label>
                    <input type="text" class="form-control custom-input"  placeholder="Enter User ID">
                </div>

                <!-- Password -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Password
                    </label>
                    <input type="password" class="form-control custom-input" placeholder="Enter Password">
                </div>

                <!-- Consent -->
                <div class="consent-box">

                    <div class="form-check">
                        <input class="form-check-input rv-checkbox" type="checkbox" id="consentCheck">

                        <label class="form-check-label" for="consentCheck">
                            I authorize the platform to securely access my
                            <strong>ITR Registration details</strong> for
                            verification purposes. I understand that my data
                            will only be used for verification and handled
                            securely.
                        </label>
                    </div>

                </div>

            </div>

            <div class="modal-footer border-0 pt-0">
                <button class="btn btn-theme w-100"> Fetch Details</button>
            </div>

        </div>
    </div>

</div>

<div class="modal fade" id="aaConsentModal" tabindex="-1" aria-labelledby="aaConsentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="aaConsentModalLabel">
                    Account Aggregator Consent
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Mobile Number
                    </label>
                    <input type="text" class="form-control custom-input" placeholder="Enter Mobile Number">
                </div>
                <div class="consent-box">

                    <div class="form-check">
                        <input class="form-check-input rv-checkbox" type="checkbox" id="consentCheck">

                        <label class="form-check-label" for="consentCheck">
                            I authorize the platform to securely access my
                            <strong>ITR Registration details</strong> for
                            verification purposes. I understand that my data
                            will only be used for verification and handled
                            securely.
                        </label>
                    </div>

                </div>
            </div>

            <div class="modal-footer border-0 pt-0">
                <button class="btn btn-theme w-100"> Fetch Details</button>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="itrModal" tabindex="-1" aria-labelledby="itrModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">

            <div class="modal-header">
                <h5 class="modal-title" id="itrModalLabel">
                    <i class="bi bi-file-earmark-text-fill text-warning me-2"></i>
                    Income Tax Return Verification
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

             <div class="modal-body">

                <!-- User ID -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        User ID
                    </label>
                    <input type="text" class="form-control custom-input"  placeholder="Enter User ID">
                </div>

                <!-- Password -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Password
                    </label>
                    <input type="password" class="form-control custom-input" placeholder="Enter Password">
                </div>

                <!-- Consent -->
                <div class="consent-box">

                    <div class="form-check">
                        <input class="form-check-input rv-checkbox" type="checkbox" id="consentCheck">

                        <label class="form-check-label" for="consentCheck">
                            I authorize the platform to securely access my
                            <strong>ITR Registration details</strong> for
                            verification purposes. I understand that my data
                            will only be used for verification and handled
                            securely.
                        </label>
                    </div>

                </div>
            </div>

              <div class="modal-footer border-0 pt-0">
                <button class="btn btn-theme w-100"> Fetch Details</button>
            </div>

        </div>
    </div>
</div>


   <script>
       const verificationModal = document.getElementById('verificationModal');
       
        verificationModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const title = button.getAttribute('data-title');
       
            verificationModal.querySelector('.modal-title').textContent = title;
        });
   </script>