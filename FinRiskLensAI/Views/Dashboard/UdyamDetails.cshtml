@using System
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    // =====================================================================
    // TEMP DATA BINDING
    // Sourced directly from the supplied Udyam Registration JSON response
    // (client_id: uan_haxdjqfNNSYxexzqaPqy). Replace this block with a
    // real model/service call once the Udyam API integration is wired to
    // a Controller/ViewModel — markup below is already written against
    // these same variable names, so that swap won't touch the HTML.
    // =====================================================================

    var enterpriseName = "M/S TRUST FINTECH LIMITED";
    var uan = "UDYAM-MH-20-0033382";
    var registrationDate = new DateTime(2021, 6, 2);
    var dateOfCommencement = new DateTime(1998, 12, 15);
    var majorActivity = "Services";
    var state = "MAHARASHTRA";
    var district = "NAGPUR";
    var city = "NAGPUR";
    var pin = "440022";
    var organizationType = "Public Limited Company";
    var gstin = "27AABCT1859L1ZY";
    var pan = "AABCT1859L";
    var mobileNumber = "7721815360";

    // enterprise_type_list, oldest first
    var enterpriseTypeHistory = new List<(string Year, string Type, DateTime ClassifiedOn)>
    {
        ("2021-22", "Small", new DateTime(2021, 6, 2)),
        ("2022-23", "Small", new DateTime(2022, 6, 26)),
        ("2023-24", "Small", new DateTime(2023, 5, 9)),
        ("2024-25", "Small", new DateTime(2024, 4, 27)),
    };
    var latestEnterpriseType = enterpriseTypeHistory.Last().Type;

    // location_of_plant_details
    var plantLocations = new List<(string UnitName, string City, string District, string State)>
    {
        ("Trust Systems and Software (India) Pvt.Ltd",              "NAGPUR", "NAGPUR", "MAHARASHTRA"),
        ("TRUST SYSTEMS AND SOFTWARE INDIA PRIVATE LIMITED",        "NAGPUR", "NAGPUR", "MAHARASHTRA"),
        ("M/S TRUST FINTECH LIMITED",                                "NAGPUR", "NAGPUR", "MAHARASHTRA"),
    };

    // nic_code
    var nicActivities = new List<(string Code, string Activity, string ActivityType)>
    {
        ("58201", "Publishing of operating systems and system software", "Services"),
        ("58201", "Publishing of operating systems and system software", "Services"),
        ("62011", "Writing, modifying, testing of computer program to meet the needs of a particular client", "Services"),
        ("74909", "Other professional, scientific and technical activities n.e.c.", "Services"),
        ("74909", "Other professional, scientific and technical activities n.e.c.", "Services"),
    };

    // ----- Derived: Business Age (accurate year count, not just year subtraction) -----
    var today = DateTime.Today;
    var businessAgeYears = today.Year - dateOfCommencement.Year;
    if (today < dateOfCommencement.AddYears(businessAgeYears)) businessAgeYears--;

    // ----- Derived: Registration status -----
    var isRegistered = registrationDate != default(DateTime);
    var registrationStatus = isRegistered ? "Active" : "Inactive";

    // ----- Derived: Enterprise stability (unchanged classification across all recorded years) -----
    var isStableClassification = enterpriseTypeHistory.Select(e => e.Type).Distinct().Count() == 1;

    // ----- Derived: NIC diversity (distinct 5-digit codes) -----
    var distinctNicCodes = nicActivities.Select(n => n.Code).Distinct().Count();

    // =====================================================================
    // BUSINESS IDENTITY SCORE — transparent, rule-based (no random values)
    // Every point below is explained; total capped at 100.
    // =====================================================================
    int score = 0;

    // 1) Business Age: >=20yrs -> +30 | 10-20 -> +25 | 5-10 -> +18 | <5 -> +10
    if (businessAgeYears >= 20) score += 30;
    else if (businessAgeYears >= 10) score += 25;
    else if (businessAgeYears >= 5) score += 18;
    else score += 10;

    // 2) Enterprise Stability: classification identical across every recorded year -> +20
    if (isStableClassification) score += 20;

    // 3) Registration: an active Udyam registration date is present -> +15
    if (isRegistered) score += 15;

    // 4) Multiple Plant Locations: 1 -> +5 | 2 -> +10 | 3+ -> +15
    if (plantLocations.Count >= 3) score += 15;
    else if (plantLocations.Count == 2) score += 10;
    else if (plantLocations.Count == 1) score += 5;

    // 5) NIC Diversity (registered activity count): 1 -> +5 | 2-3 -> +10 | 4+ -> +15
    if (nicActivities.Count >= 4) score += 15;
    else if (nicActivities.Count >= 2) score += 10;
    else if (nicActivities.Count == 1) score += 5;

    // 6) Organization Type: Public Limited Company -> +5
    if (organizationType.Equals("Public Limited Company", StringComparison.OrdinalIgnoreCase)) score += 5;

    // 7) GST Available -> +5
    if (!string.IsNullOrWhiteSpace(gstin)) score += 5;

    // 8) PAN Available -> +5
    if (!string.IsNullOrWhiteSpace(pan)) score += 5;

    // Maximum achievable score is 100 — cap here rather than let criteria overflow it
    var businessIdentityScore = Math.Min(score, 100);

    // ----- Risk Classification (derived purely from the score above) -----
    string riskLabel, riskCss;
    if (businessIdentityScore >= 90) { riskLabel = "Very Low Risk"; riskCss = "risk-verylow"; }
    else if (businessIdentityScore >= 75) { riskLabel = "Low Risk"; riskCss = "risk-low"; }
    else if (businessIdentityScore >= 60) { riskLabel = "Medium Risk"; riskCss = "risk-medium"; }
    else if (businessIdentityScore >= 40) { riskLabel = "High Risk"; riskCss = "risk-high"; }
    else { riskLabel = "Very High Risk"; riskCss = "risk-veryhigh"; }

    // ----- Business Classification (derived, not a lookup table) -----
    string businessClassification;
    if (businessAgeYears >= 20 && isStableClassification && isRegistered && plantLocations.Count >= 2)
        businessClassification = "Stable";
    else if (businessAgeYears >= 5 && isStableClassification)
        businessClassification = "Growing";
    else if (businessAgeYears < 5)
        businessClassification = "Emerging";
    else
        businessClassification = "Needs Verification";

    // ----- Strengths: only include what the JSON actually supports -----
    var strengths = new List<string>();
    if (isRegistered) strengths.Add("Registered MSME");
    strengths.Add($"Operating since {dateOfCommencement.Year} ({businessAgeYears}+ Years)");
    if (isStableClassification) strengths.Add($"Stable {latestEnterpriseType} Enterprise Classification");
    if (plantLocations.Count > 1) strengths.Add($"Multiple Plant Locations ({plantLocations.Count})");
    if (!string.IsNullOrWhiteSpace(gstin)) strengths.Add("GST Registered");
    if (!string.IsNullOrWhiteSpace(pan)) strengths.Add("PAN Verified");
    if (organizationType.Equals("Public Limited Company", StringComparison.OrdinalIgnoreCase)) strengths.Add("Public Limited Company");
    if (distinctNicCodes > 1) strengths.Add($"Diverse Service Activities ({distinctNicCodes} NIC Codes)");

    // ----- Observations: short professional AI-style summary (max 3 lines) -----
    var observations =
        $"Established MSME operating for over {businessAgeYears} years with a consistently maintained {latestEnterpriseType} Enterprise classification across all recorded years. " +
        $"Multiple registered plant locations ({plantLocations.Count}), verified GST and PAN records, and diversified NIC service activities point to a mature, credible business profile. " +
        $"Overall business identity confidence is assessed as {riskLabel}, supporting a favorable credit assessment posture.";
}

<div class="container-fluid py-4 udyam-dashboard">

    <!-- Header & Action Row -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-end mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 verified-tag mb-1">
                <i class="bi bi-patch-check-fill"></i>
                <span>UDYAM REGISTRATION @registrationStatus.ToUpper()</span>
            </div>
            <h2 class="dashboard-title mb-1">Business Identity &amp; Trust Analysis</h2>
            <p class="text-muted mb-0">
                @enterpriseName &middot; Registration No: <span id="udyamRegNumber">@uan</span>
            </p>
        </div>
        <div class="d-flex gap-2">
            <button id="btnDownloadReport" type="button" class="btn btn-outline-theme">
                <i class="bi bi-download me-1"></i> Download Report
            </button>
            <button id="btnRefreshData" type="button" class="btn btn-theme">
                <i class="bi bi-arrow-clockwise me-1"></i> Refresh Data
            </button>
        </div>
    </div>

    <div class="row g-4">

        <!-- Business Identity Score -->
        <div class="col-12 col-lg-4">
            <div class="dash-card glass-card h-100 text-center d-flex flex-column align-items-center justify-content-center position-relative">
                <i class="bi bi-info-circle info-icon position-absolute top-0 end-0 m-3"
                   title="Score = Business Age + Enterprise Stability + Registration + Plant Locations + NIC Diversity + Org Type + GST + PAN (see Observations for detail)"></i>

                <h6 class="card-subtitle mb-4">Business Identity Score</h6>

                <div class="score-gauge">
                    <svg viewBox="0 0 200 200">
                        <circle class="gauge-track" cx="100" cy="100" r="88"></circle>
                        <circle id="gaugeProgress" class="gauge-progress" cx="100" cy="100" r="88"></circle>
                    </svg>
                    <div class="score-value">
                        <span id="reliabilityScore">@businessIdentityScore</span>
                        <small>/ 100</small>
                    </div>
                </div>

                <span class="risk-badge @riskCss mt-4">@riskLabel</span>
                <span class="classification-tag mt-2">@businessClassification Business</span>
            </div>
        </div>

        <!-- Business Identity Card -->
        <div class="col-12 col-md-6 col-lg-4">
            <div class="dash-card h-100">
                <h6 class="card-heading"><i class="bi bi-building me-2"></i>Business Identity</h6>
                <ul class="profile-list list-unstyled mb-0">
                    <li><span>Business Name</span><strong class="text-end">@enterpriseName</strong></li>
                    <li><span>Enterprise Type</span><strong>@latestEnterpriseType</strong></li>
                    <li><span>Business Age</span><strong>@businessAgeYears Years</strong></li>
                    <li><span>Registration Date</span><strong>@registrationDate.ToString("dd MMM yyyy")</strong></li>
                    <li><span>Organization Type</span><strong class="text-end">@organizationType</strong></li>
                    <li class="no-border"><span>Major Activity</span><strong>@majorActivity</strong></li>
                </ul>
            </div>
        </div>

        <!-- Strengths -->
        <div class="col-12 col-md-6 col-lg-4">
            <div class="dash-card h-100">
                <h6 class="card-heading">Identified Strengths</h6>
                <ul class="signal-list list-unstyled mb-0">
                    @foreach (var s in strengths)
                    {
                        <li>
                            <i class="bi bi-check-circle-fill"></i>
                            <div><p class="signal-title mb-0">@s</p></div>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <!-- Classification Timeline -->
        <div class="col-12 col-lg-8">
            <div class="dash-card glass-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                    <h6 class="card-heading mb-0">Enterprise Classification Timeline</h6>
                    <span class="legend"><span class="legend-dot"></span> Stable Classification</span>
                </div>
                <div class="classification-timeline">
                    @foreach (var entry in enterpriseTypeHistory)
                    {
                        <div class="timeline-step">
                            <div class="timeline-dot"></div>
                            <div class="timeline-year">@entry.Year</div>
                            <div class="timeline-type">@entry.Type</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Location Summary + Compliance Summary -->
        <div class="col-12 col-lg-4 d-flex flex-column gap-4">
            <div class="dash-card location-card flex-grow-1">
                <h6 class="card-label">Location Summary</h6>
                <ul class="mini-list">
                    <li><span>State</span><strong>@state</strong></li>
                    <li><span>District</span><strong>@district</strong></li>
                    <li><span>City</span><strong>@city</strong></li>
                    <li><span>PIN</span><strong>@pin</strong></li>
                    <li><span>Total Locations</span><strong>@plantLocations.Count</strong></li>
                </ul>
            </div>
            <div class="dash-card compliance-card">
                <h6 class="card-label">Compliance Summary</h6>
                <ul class="mini-list mini-list-dark">
                    <li><span>GST</span><strong>@(string.IsNullOrWhiteSpace(gstin) ? "Not Available" : gstin)</strong></li>
                    <li><span>PAN</span><strong>@(string.IsNullOrWhiteSpace(pan) ? "Not Available" : pan)</strong></li>
                    <li><span>Registration</span><strong class="status-active"><i class="bi bi-dot"></i>@registrationStatus</strong></li>
                </ul>
            </div>
        </div>

        <!-- Plant Location Card -->
        <div class="col-12 col-lg-6">
            <div class="dash-card h-100">
                <h6 class="card-heading"><i class="bi bi-geo-alt-fill me-2"></i>Registered Plant Locations (@plantLocations.Count)</h6>
                <div class="table-responsive">
                    <table class="table dash-table mb-0">
                        <thead>
                            <tr><th>Unit Name</th><th>City</th><th>District</th><th>State</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var loc in plantLocations)
                            {
                                <tr>
                                    <td>@loc.UnitName</td>
                                    <td>@loc.City</td>
                                    <td>@loc.District</td>
                                    <td>@loc.State</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- NIC Activities Card -->
        <div class="col-12 col-lg-6">
            <div class="dash-card h-100">
                <h6 class="card-heading"><i class="bi bi-diagram-3-fill me-2"></i>NIC Activities (@nicActivities.Count)</h6>
                <div class="table-responsive">
                    <table class="table dash-table mb-0">
                        <thead>
                            <tr><th>NIC Code</th><th>Activity</th><th>Type</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var nic in nicActivities)
                            {
                                <tr>
                                    <td>@nic.Code</td>
                                    <td>@nic.Activity</td>
                                    <td><span class="pill-type">@nic.ActivityType</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Observations -->
        <div class="col-12">
            <div class="dash-card observations-card">
                <h6 class="card-heading"><i class="bi bi-stars me-2"></i>AI Observations</h6>
                <p class="observations-text mb-0">@observations</p>
            </div>
        </div>

    </div>
</div>

@* ================================================================
   Preserved verification modals (GST / Account Aggregator / ITR).
   Not currently triggered from this view since the launcher cards
   were replaced by the analysis dashboard above, but kept in place
   with existing IDs/markup intact for reuse (e.g. "Refresh Data",
   re-verification flows, or future wiring) without breaking any
   JS hooks already built against them.
   ================================================================ *@

