@model FinRiskLensAI.Models.McaDetailsViewModel
@{
    ViewBag.Title = "MCA Details";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    string Dt(string d) => (string.IsNullOrEmpty(d) || d.StartsWith("1800")) ? "—" : d;
    string Inr(long v) =>
        v >= 10000000 ? (v / 10000000d).ToString("0.##") + " Cr" :
        v >= 100000 ? (v / 100000d).ToString("0.##") + " L" : v.ToString("N0");
}

<style>
    .fhc-wrap { padding: 24px; max-width: 1320px; margin: 0 auto; font-family: var(--font-data, 'Inter', sans-serif); }
    .fhc-card { background: #fff; border: 1px solid #ead9df; border-radius: 16px; padding: 20px 22px; box-shadow: 0 2px 10px rgba(87,0,29,.05); height: 100%; }
    .fhc-title { font-family: var(--font-headline, 'Sora', sans-serif); font-weight: 700; color: #57001d; }
    .fhc-sub { color: #974354; font-size: .85rem; }
    .fhc-section-label { font-size: .72rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #974354; margin-bottom: 12px; }

    .mca-chip { display: inline-flex; align-items: center; gap: 6px; padding: 5px 13px; border-radius: 999px; font-weight: 700; font-size: .8rem; }
    .chip-active { background: #e3f4ea; color: #0f5137; }
    .chip-other { background: #fdf3d7; color: #8a6d00; }

    .stat-tile { background: #faf7f8; border: 1px solid #ead9df; border-radius: 12px; padding: 12px 14px; }
    .stat-tile .v { font-family: var(--font-headline, 'Sora', sans-serif); font-weight: 700; font-size: 1.2rem; color: #2b2026; }
    .stat-tile .k { font-size: .7rem; color: #974354; text-transform: uppercase; letter-spacing: .06em; }

    .kv-row { display: flex; justify-content: space-between; gap: 12px; padding: 9px 0; border-bottom: 1px dashed #f0e2e7; font-size: .87rem; }
    .kv-row:last-child { border-bottom: none; }
    .kv-k { color: #974354; }
    .kv-v { color: #2b2026; font-weight: 600; text-align: right; }

    .mca-table { width: 100%; border-collapse: collapse; font-size: .85rem; }
    .mca-table th { text-align: left; font-size: .7rem; text-transform: uppercase; letter-spacing: .05em; color: #974354; padding: 8px 10px; border-bottom: 2px solid #ead9df; }
    .mca-table td { padding: 9px 10px; border-bottom: 1px solid #f2e6ea; color: #2b2026; }
    .mca-table tr:last-child td { border-bottom: none; }
    .amt { font-family: var(--font-headline, 'Sora', sans-serif); font-weight: 700; color: #57001d; }
    .st-open { background: #fbe0e0; color: #8b1020; padding: 2px 9px; border-radius: 20px; font-size: .72rem; font-weight: 600; }
</style>

<div class="fhc-wrap">

    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
            <h3 class="fhc-title mb-1">MCA Company Profile</h3>
            <div class="fhc-sub">Ministry of Corporate Affairs — registration, directors &amp; registered charges</div>
        </div>
    </div>

    @if (Model.LoadError != null)
    {
        <div class="alert alert-danger rounded-4">@Model.LoadError</div>
    }
    else if (!Model.HasData)
    {
        <div class="fhc-card text-center py-5">
            <i class="bi bi-building" style="font-size:3rem;color:#974354;"></i>
            <h5 class="fhc-title mt-3">No MCA record available</h5>
        </div>
    }
    else
    {
        <!-- Header row: name + CIN + status -->
        <div class="fhc-card mb-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <div class="fhc-title" style="font-size:1.25rem;">@Model.CompanyName</div>
                    <div class="fhc-sub"><i class="bi bi-hash"></i> CIN @Model.Cin &middot; @Model.RocCode</div>
                </div>
                <span class="mca-chip @(Model.Status.Equals("Active", StringComparison.OrdinalIgnoreCase) ? "chip-active" : "chip-other")">
                    <i class="bi bi-patch-check-fill"></i> @Model.Status
                </span>
            </div>
        </div>

        <!-- Stat tiles -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3"><div class="stat-tile"><div class="v">@Model.Directors.Count</div><div class="k">Directors</div></div></div>
            <div class="col-6 col-md-3"><div class="stat-tile"><div class="v">@Model.Charges.Count</div><div class="k">Registered Charges</div></div></div>
            <div class="col-6 col-md-3"><div class="stat-tile"><div class="v">@Model.OpenChargeCount</div><div class="k">Open Charges</div></div></div>
            <div class="col-6 col-md-3"><div class="stat-tile"><div class="v">₹@Inr(Model.TotalOpenChargeAmount)</div><div class="k">Secured (Open) Amount</div></div></div>
        </div>

        <div class="row g-4 mb-4">
            <!-- Company info -->
            <div class="col-lg-5">
                <div class="fhc-card">
                    <div class="fhc-section-label">Company Information</div>
                    <div class="kv-row"><span class="kv-k">Class</span><span class="kv-v">@Model.CompanyClass</span></div>
                    <div class="kv-row"><span class="kv-k">Category</span><span class="kv-v">@Model.Category</span></div>
                    <div class="kv-row"><span class="kv-k">Listed status</span><span class="kv-v">@Model.Listed</span></div>
                    <div class="kv-row"><span class="kv-k">Incorporated</span><span class="kv-v">@Dt(Model.IncorporationDate)</span></div>
                    <div class="kv-row"><span class="kv-k">Authorized capital</span><span class="kv-v">₹@Inr(long.Parse(Model.AuthorizedCapital))</span></div>
                    <div class="kv-row"><span class="kv-k">Paid-up capital</span><span class="kv-v">₹@Inr(long.Parse(Model.PaidUpCapital))</span></div>
                    <div class="kv-row"><span class="kv-k">Registered office</span><span class="kv-v" style="max-width:60%;">@Model.RegisteredAddress</span></div>
                </div>
            </div>

            <!-- Directors -->
            <div class="col-lg-7">
                <div class="fhc-card">
                    <div class="fhc-section-label"><i class="bi bi-people-fill me-1"></i>Directors</div>
                    <table class="mca-table">
                        <thead><tr><th>Name</th><th>DIN</th><th>Since</th></tr></thead>
                        <tbody>
                            @foreach (var d in Model.Directors)
                            {
                                <tr>
                                    <td style="font-weight:600;">@d.Name</td>
                                    <td>@d.Din</td>
                                    <td>@Dt(d.StartDate)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Charges -->
        <div class="fhc-card mb-4">
            <div class="fhc-section-label"><i class="bi bi-shield-lock-fill me-1"></i>Registered Charges (existing secured liabilities)</div>
            @if (Model.Charges.Count == 0)
            {
                <div class="fhc-sub py-2">No charges registered against this company.</div>
            }
            else
            {
                <table class="mca-table">
                    <thead><tr><th>Assets under charge</th><th>Amount</th><th>Created</th><th>Modified</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var c in Model.Charges)
                        {
                            <tr>
                                <td>@c.Asset</td>
                                <td class="amt">₹@Inr(c.Amount)</td>
                                <td>@Dt(c.Created)</td>
                                <td>@Dt(c.Modified)</td>
                                <td><span class="st-open">@c.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="fhc-sub mt-3">
                    <i class="bi bi-info-circle me-1"></i>Open charges represent existing secured lending / liens — a key input to the credit exposure assessment.
                </div>
            }
        </div>
    }
</div>
