@{
    ViewBag.Title = "CustOnboarding";
    Layout = "~/Views/Shared/_CustOnboardingLayout.cshtml";
}


<style>
    :root {
        --primary: #5e0023;
        --primary-container: #801538;
        --on-primary: #ffffff;
        --secondary: #725c1e;
        --secondary-container: #fcdd91;
        --background: #fbf9f6;
        --surface-lowest: #ffffff;
        --surface-low: #f5f3f0;
        --on-surface: #1b1c1a;
        --on-surface-variant: #564145;
        --outline-variant: #dcbfc3;
    }

    body {
        font-family: 'Manrope', sans-serif;
        background-color: var(--background);
        background-image: radial-gradient(at 0% 0%, rgba(128,21,56,0.05) 0px, transparent 50%), radial-gradient(at 100% 100%, rgba(230,200,127,0.10) 0px, transparent 50%);
        color: var(--on-surface);
        min-height: 100vh;
    }

    .navbar-brand-mark {
        width: 40px;
        height: 40px;
        background-color: var(--secondary-container);
        color: var(--primary);
        border-radius: .5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: .85rem;
    }

    .text-primary-brand {
        color: var(--primary) !important;
    }

    .text-secondary-brand {
        color: var(--secondary) !important;
    }

    .eyebrow {
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .2em;
        text-transform: uppercase;
        color: var(--on-surface-variant);
    }

    .login-card {
        background: var(--surface-lowest);
        border: 1px solid rgba(220,191,195,.35);
        border-radius: .75rem;
        box-shadow: 0 4px 20px rgba(0,0,0,.04), 0 12px 40px rgba(128,21,56,.03);
    }

    .card-header-custom {
        border-bottom: 1px solid rgba(220,191,195,.4);
    }

    .icon-tile {
        width: 48px;
        height: 48px;
        border-radius: .5rem;
        background-color: rgba(252,221,145,.20);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--secondary);
        font-size: 1.4rem;
    }

    .form-label-custom {
        font-size: .85rem;
        font-weight: 600;
        color: var(--on-surface-variant);
    }

    .form-control-custom {
        height: 56px;
        background-color: var(--surface-low);
        border: 1px solid var(--outline-variant);
        border-radius: .5rem;
        padding-left: 2.75rem;
    }

        .form-control-custom:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 .2rem rgba(94,0,35,.15);
        }

    .input-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--on-surface-variant);
        pointer-events: none;
    }

    .toggle-visibility {
        position: absolute;
        right: 1rem;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: var(--on-surface-variant);
        cursor: pointer;
    }

        .toggle-visibility:hover {
            color: var(--primary);
        }

    .btn-brand {
        background-color: var(--primary-container);
        color: var(--on-primary);
        border: none;
        height: 56px;
        border-radius: .5rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .6rem;
        transition: all .15s ease;
    }

        .btn-brand:hover {
            background-color: var(--primary);
            color: var(--on-primary);
            box-shadow: 0 8px 20px rgba(94,0,35,.20);
        }

        .btn-brand:active {
            transform: scale(.98);
        }

    .btn-outline-brand {
        border: 1px solid var(--primary-container);
        color: var(--primary-container);
        border-radius: .5rem;
        height: 48px;
        font-weight: 600;
        font-size: .85rem;
    }

        .btn-outline-brand:hover {
            background-color: rgba(128,21,56,.05);
            color: var(--primary-container);
        }

    .trust-box {
        background-color: rgba(114,92,30,.06);
        border: 1px solid rgba(252,221,145,.25);
        border-radius: .5rem;
    }

    .step-badge {
        width: 32px;
        height: 32px;
        border: 2px solid var(--primary-container);
        color: var(--primary);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .7rem;
        font-weight: 700;
    }

    footer a {
        color: var(--on-surface-variant);
        text-decoration: none;
        font-size: .85rem;
    }

        footer a:hover {
            color: var(--primary);
        }
</style>

<!-- Main -->
<div class="container py-4 py-md-1" style="margin-top:58px">
    <div id="onboardingFlow">
        <div class="mx-auto" style="max-width:500px;">
            <div class="stage-card fade-step" id="step1">

                <div class="stage-head d-flex align-items-center gap-3">
                    <div class="stage-icon">
                        <i class="bi bi-envelope-at"></i>
                    </div>

                    <h2 class="stage-title mb-0">Welcome Back!</h2>
                </div>

                <div class="stage-body">

                    <!-- BOX 1 -->
                    <div class="box-1" id="box1">

                        <label class="form-label">Enter your Email ID</label>

                        <div class="input-group input-group-lg mb-2">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-envelope text-muted"></i>
                            </span>

                            <input type="email"
                                   id="email"
                                   class="form-control"
                                   placeholder="Enter your registered email">
                        </div>

                        <div class="help-text mb-3">
                            <i class="bi bi-info-circle-fill"></i>
                            We'll send a 6-digit OTP to your registered email.
                        </div>

                        <div class="text-end">
                            <button class="btn btn-maroon btn-sm px-4" id="generateOtpBtn">
                                <i class="bi bi-send me-1"></i>
                                Generate OTP
                            </button>
                        </div>

                    </div>

                    <!-- BOX 2 -->
                    <div class="box-2 mt-4 d-none" id="box2">

                        <hr />

                        <label class="form-label">Enter OTP</label>

                        <div class="input-group input-group-lg mb-2">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-shield-lock"></i>
                            </span>

                            <input type="text"
                                   id="otp"
                                   maxlength="6"
                                   class="form-control"
                                   placeholder="Enter 6-digit OTP">
                        </div>

                        <div class="help-text mb-3">
                            OTP has been sent to your email.
                        </div>

                        <div class="text-end">
                            <button type="button"
                                    class="btn btn-brand"
                                    id="submitBtn">

                                <i class="bi bi-box-arrow-in-right"></i>
                                <span id="submitLabel">Login to Portal</span>
                            </button>
                        </div>

                    </div>

                </div>

            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="otpDisplayModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Your OTP</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <p class="mb-1">Use this OTP to continue:</p>
                <h2 id="otpDisplayValue" class="fw-bold"></h2>
            </div>
        </div>
    </div>
</div>

<script>

 $(document).ready(function() {

     $("#generateOtpBtn").click(function () {

         var email = $("#email").val().trim();

         if (email == "") {
             $("#email").addClass("is-invalid");
             return;
         }

         $("#email").removeClass("is-invalid");

         var model = {
             Email: email
         };

         var $btn = $("#generateOtpBtn");
         var originalHtml = $btn.html();

         $.ajax({

             url: "/Auth/GenCustomerOtp",
             type: "POST",
             data: model,

             beforeSend: function () {

                 $btn.prop("disabled", true);
                 $btn.html('<i class="bi bi-arrow-repeat"></i> <span>Sending OTP...</span>');
             },

             success: function (res) {

                 $btn.prop("disabled", false);
                 $btn.html(originalHtml);

                 if (res.status) {

                      // Show OTP in modal (Development only)
                     $("#otpDisplayValue").text(res.otp);

                     var otpModal = new bootstrap.Modal(document.getElementById("otpDisplayModal"));
                     otpModal.show();


                     // Hide Generate OTP button
                     $("#generateOtpBtn").addClass("d-none");
                     
                     // Lock Email textbox
                     $("#email").prop("readonly", true);
                     
                     // Show OTP Box
                     $("#box2").removeClass("d-none");
                     
                     // Smooth scroll to OTP section
                     $('html, body').animate({
                         scrollTop: $("#box2").offset().top - 80
                     }, 300);
                     
                     // Focus OTP input
                     $("#otp").focus();
                 }
                 else {

                    // showToast(res.message);
                 }
             },

             error: function () {

                 $btn.prop("disabled", false);
                 $btn.html(originalHtml);

                 showToast("Something went wrong while sending OTP.");
             }

         });

      });


     $("#submitBtn").click(function () {

        var model = {
            Email: $("#email").val(),
            OTP: $("#otp").val()
        };

        $.ajax({

                url: "/Auth/ValidateUserOtp",
            type: "POST",
            data: model,

            beforeSend: function () {

                $("#submitBtn").prop("disabled", true);
                $("#submitLabel").text("Validating...");
            },

            success: function (res) {

                $("#submitBtn").prop("disabled", false);
                $("#submitLabel").text("Login to Portal");

                if (res.status) {

                        window.location.href = "/Dashboard/CustDashboard";
                }
                else {

                    alert(res.message);

                    $("#otp").val("");
                    $("#otp").focus();
                }
            },

            error: function () {

                $("#submitBtn").prop("disabled", false);
                $("#submitLabel").text("Login to Portal");

                alert("Something went wrong.");
            }

        });

    });

});


     

</script>

